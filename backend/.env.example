# ─── Database ────────────────────────────────────────────────
# Leave blank for local SQLite. On Render, paste the PostgreSQL URL here.
DATABASE_URL=

# ─── SMTP Email Configuration ────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-company-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-company-email@gmail.com

# ─── Frontend URL (used in reset password email links) ───────
FRONTEND_URL=https://your-app.vercel.app
